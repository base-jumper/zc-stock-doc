#!/usr/bin/env bash
# Wrapper: resolves to the repo even when invoked via a symlink on PATH.
# edgar is stdlib-only (SEC XBRL over urllib), so it runs on system python3 —
# no virtualenv, unlike yfin.
self="$(readlink -f "${BASH_SOURCE[0]}")"
root="$(cd "$(dirname "$self")/../.." && pwd)"
exec python3 "$root/skills/sec-edgar/scripts/edgar.py" "$@"
